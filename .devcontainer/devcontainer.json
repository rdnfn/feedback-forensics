{
	"name": "Feedback Forensics",
	"image": "mcr.microsoft.com/devcontainers/python:3-3.13-trixie",
	"forwardPorts": [
		7860
	],
	"features": {
		// Required to fetch datasets from huggingface
		"ghcr.io/devcontainers/features/git-lfs:1": {
			"autoPull": "false"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	// Secrets (GH_TOKEN) live in a gitignored env file; create it if missing so the build doesn't fail
	"initializeCommand": "touch .devcontainer/devcontainer.env",
	"runArgs": [
		"--env-file",
		"${localWorkspaceFolder}/.devcontainer/devcontainer.env"
	],
	"remoteEnv": {
		// Don't expose the host's forwarded SSH agent; git uses GH_TOKEN over HTTPS instead
		"SSH_AUTH_SOCK": ""
	},
	// Route git through gh's token (the origin remote stays an SSH URL for use on the host)
	"postCreateCommand": "pip install -e .[dev] && git config --global credential.https://github.com.helper '!gh auth git-credential' && git config --global url.https://github.com/.insteadOf git@github.com:",
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code"
			]
		}
	}
}